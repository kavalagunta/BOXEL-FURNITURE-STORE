{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-RENDER-URL/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://YOUR-RENDER-URL/uploads/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://YOUR-RENDER-URL/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://YOUR-RENDER-URL/robots.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}