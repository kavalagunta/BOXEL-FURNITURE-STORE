{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.boxel.in/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://api.boxel.in/uploads/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://api.boxel.in/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://api.boxel.in/robots.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
